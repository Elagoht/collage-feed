// A collage plugin that serves RSS 2.0 and Atom 1.0 feeds from items the
// application lists, and announces them in every page's head.
//
// It requires collage the way any consumer does, and reaches nothing the framework
// does not offer every plugin.
module github.com/Elagoht/collage-feed

go 1.26

require github.com/Elagoht/collage v0.21.0
